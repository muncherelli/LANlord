# written by lanlord; changes here are overwritten on the next apply
[global]
   workgroup = {{ nt4_name }}
   netbios name = {{ nt4_netbios_name }}
   server string = LANlord

   # only the internal network ever sees this server
   interfaces = {{ nt4_address }}
   bind interfaces only = yes

   # old windows needs smb1 and ntlmv1, which is why this must stay off the host network
   server min protocol = NT1
   ntlm auth = ntlmv1-permitted
   lanman auth = {{ 'yes' if nt4.lanman_auth | default(false) else 'no' }}
   security = user
   encrypt passwords = yes
   map to guest = never
   username map = /etc/samba/usermap

   passdb backend = tdbsam
   idmap config * : backend = tdb
   idmap config * : range = 3000-7999

   wins support = {{ 'yes' if nt4_wins | default(true) else 'no' }}
   dns proxy = no
   # raise this (for example '2 rpc_srv:10 passdb:10 auth:5') with nt4-domain.log_level to debug a join
   log level = {{ nt4.log_level | default('1') }}
{% if nt4_mode == 'domain' %}

   server role = classic primary domain controller
   domain logons = yes
   domain master = yes
   preferred master = yes
   local master = yes
   os level = 255

   # user manager for domains: every change goes through lanlord-user, which keeps the unix side and
   # the state in /var/lib/samba/private, so the next apply or restart does not undo it. smbd runs
   # these through a shell and does not clean the names of add and delete user, so every macro is
   # quoted here and lanlord-user checks each name again
   add machine script = /usr/local/bin/lanlord-user hook machine '%u'
   add user script = /usr/local/bin/lanlord-user hook useradd '%u'
   delete user script = /usr/local/bin/lanlord-user hook deluser '%u'
   rename user script = /usr/local/bin/lanlord-user hook rename '%uold' '%unew'
   add group script = /usr/local/bin/lanlord-user hook addgroup '%g'
   delete group script = /usr/local/bin/lanlord-user hook delgroup '%g'
   add user to group script = /usr/local/bin/lanlord-user hook addmember '%g' '%u'
   delete user from group script = /usr/local/bin/lanlord-user hook delmember '%g' '%u'
   set primary group script = /usr/local/bin/lanlord-user hook setprimary '%g' '%u'

   # NT4 cannot use schannel or the strong netlogon session key, so allow what it does speak.
   # this weakens the domain on purpose: keep it on the isolated retronet only.
{% if nt4.roaming_profiles | default(false) %}
   # roaming profiles: nt4 keeps each user's profile in the profiles share
   logon path = \\%N\profiles\%U
   logon home = \\%N\%U\.win9x
   logon drive = H:
{% else %}
   # no roaming profiles or network home directories: nt4 uses a local profile and stays quiet
   logon path =
   logon home =
{% endif %}

   # every user has a small wrapper in netlogon\users that sets %USERNAME% (windows 9x does not) and
   # runs lanlord.bat, which maps S: and then runs your own scripts
   logon script = users\%U.bat

   server schannel = auto
   allow nt4 crypto = yes
   reject md5 clients = no

[netlogon]
   comment = logon scripts; domain admins may edit them
   path = /var/lib/samba/netlogon
   read only = yes
   write list = @admins
   force group = admins
   create mask = 0664
   force create mode = 0664
   directory mask = 2775
   guest ok = no
{% if nt4.software | default(false) %}

[software]
   comment = software installers; domain users read, domain admins and software admins write
   path = /var/lib/samba/software
   read only = yes
   valid users = @domusers @admins
   write list = @admins @softadmins
   force group = softadmins
   create mask = 0664
   force create mode = 0664
   directory mask = 2775
   force directory mode = 2775
{% endif %}
{% if nt4.roaming_profiles | default(false) %}

[homes]
   comment = home folders; windows 95 and 98 keep their roaming profile in one
   path = /var/lib/samba/homes/%S
   read only = no
   browseable = no
   valid users = %S
   create mask = 0600
   directory mask = 0700

[profiles]
   path = /var/lib/samba/profiles
   read only = no
   browseable = no
   csc policy = disable
   create mask = 0600
   directory mask = 0700
{% endif %}
{% else %}

   server role = standalone server
{% endif %}
