# written by lanlord; changes here are overwritten on the next apply
[global]
   workgroup = {{ nt4_name }}
   netbios name = {{ nt4_netbios_name }}
   server string = LANlord

   # only the internal network ever sees this server
   interfaces = {{ nt4_address }}
   bind interfaces only = yes

   # old windows needs smb1 and ntlmv1, which is why this must stay off the host network
   server min protocol = NT1
   ntlm auth = ntlmv1-permitted
   lanman auth = {{ 'yes' if nt4.lanman_auth | default(false) else 'no' }}
   security = user
   encrypt passwords = yes
   map to guest = never
   username map = /etc/samba/usermap

   passdb backend = tdbsam
   idmap config * : backend = tdb
   idmap config * : range = 3000-7999

   wins support = yes
   dns proxy = no
   # raise this (for example '2 rpc_srv:10 passdb:10 auth:5') with nt4-domain.log_level to debug a join
   log level = {{ nt4.log_level | default('1') }}
{% if nt4_mode == 'domain' %}

   server role = classic primary domain controller
   domain logons = yes
   domain master = yes
   preferred master = yes
   local master = yes
   os level = 255
   add machine script = /usr/sbin/useradd --badname -M -g machines -d /dev/null -s /usr/sbin/nologin %u

   # NT4 cannot use schannel or the strong netlogon session key, so allow what it does speak.
   # this weakens the domain on purpose: keep it on the isolated retronet only.
{% if nt4.roaming_profiles | default(false) %}
   # roaming profiles: nt4 keeps each user's profile in the profiles share
   logon path = \\%N\profiles\%U
   logon home =
{% else %}
   # no roaming profiles or network home directories: nt4 uses a local profile and stays quiet
   logon path =
   logon home =
{% endif %}

   server schannel = auto
   allow nt4 crypto = yes
   reject md5 clients = no

[netlogon]
   path = /var/lib/samba/netlogon
   read only = yes
   guest ok = no
{% if nt4.roaming_profiles | default(false) %}

[profiles]
   path = /var/lib/samba/profiles
   read only = no
   browseable = no
   profile acls = yes
   csc policy = disable
   create mask = 0600
   directory mask = 0700
{% endif %}
{% else %}

   server role = standalone server
{% endif %}
