#!/bin/bash
# runs one command on a domain member over smb1, psexec style: nothing is installed on the machine.
# a .bat and a small service helper (lanlord-svc.exe, built into the image) go into <drive>:\lanlord
# (the <drive>$ admin share, the system drive found from the path of ADMIN$), a service started from the
# helper runs the .bat with cmd.exe, and the output is streamed back.
# %SystemRoot%\Temp is writable by Everyone on nt4, and Everyone also holds delete-child there (and in
# %SystemRoot%), so no folder under them can be protected: a local user could swap the helper or the
# .bat before the service starts and get LocalSystem, or read other runs' output. the work folder is
# at the root of the system drive instead, and every run goes through these steps, in this order:
#   1. stale services and files are swept (in the old places: the root, Temp and Temp\lanlord)
#   2. the acl of the drive root is read (smbcacls) and the run is refused unless no account other than
#      Administrators, SYSTEM and Creator Owner can delete children, change permissions, take
#      ownership or has full or generic write access there (that is what lets a user rename the folder
#      away and put their own in its place), and the root is owned by Administrators or SYSTEM
#   3. <drive>:\lanlord is made (an existing one is fine, but it must be a folder, and when it already
#      exists its owner must be Administrators or SYSTEM: ownership is never taken, as a handle that
#      was opened with WRITE_DAC would survive it); owner and dacl are set (Administrators and SYSTEM
#      full, inherited by files and subfolders), the acl is read back and verified
#   4. stale ll-<8 hex>.* files in the folder (a timed-out run's output, which its still running program
#      held open when it was cleaned up) are deleted, failures ignored; only after the folder is verified
#   5. the files are uploaded
#   6. right before the service is created the root, the folder and the uploaded files are verified
#      again (the files' owner must be Administrators, SYSTEM or the login's own sid)
# any smbcacls or rpcclient error, or an acl that is not as expected, refuses the run (fail closed).
# two small windows remain. on the first creation on a machine the new folder inherits the drive root's
# acl (Everyone: change) until the lock is set, which is the very next call after the mkdir; a user who
# opens the folder in between keeps that handle until reboot. later runs verify the folder but cannot
# detect held handles. and after the last verification and before the service has opened the helper,
# an account that can already write there (an administrator, or whoever changes the drive root acl in
# that moment) could still swap a file.
#   lanlord-exec run --machine NAME [--address ADDR] --timeout N [--hash-command]
#                             stdin: {"user":"...","password":"...","command":"...","caller":"..."}
#                             caller is optional (letters, digits and ._@- only; "cli" when absent)
#   lanlord-exec sweep --machine NAME [--address ADDR]
#                             stdin: {"user":"...","password":"..."}
#                             remove services and files that an earlier run left behind
# stdout is one json object per line after the LANLORD_EVENT marker:
#   {"stream":"out"|"err","data":"<base64>"}   new bytes of the command's output
#   {"exit":N} | {"timed_out":true} | {"error":"..."}   the last line of a run
# {"stream":...} lines carry at most 1 MiB of raw bytes each; more output comes as several lines.
# every run appends one tab separated line to the audit log (LANLORD_EXEC_LOG, default
# /var/lib/samba/private/exec.log, 0600): time, caller, machine, address, the command (or
# sha256:<hex> with --hash-command), the exit code or timed_out, error, killed (a signal) or refused (a bad command), and the duration. the
# password is never written. the log rotates at 1 MiB and keeps one .1; when it cannot be written
# the run still completes and stderr gets a warning.
# a free-form command must not use a plain "exit N": it ends the outer cmd.exe, so the exit code
# is never written and the run shows as timed_out. nt4 has no "exit /b", and "cmd /c exit N" does not
# help (nt4's cmd returns 0 for it): the exit code is the errorlevel of the last program run. core refuses a command in which any part, split at &, && || and parentheses and
# after a leading @, if ... or do, starts with exit; a single | does not split, as the right side of
# a pipe runs in a child cmd.
# a command that outlives its timeout is killed: the service is stopped first, and the helper ends
# its cmd.exe. programs that cmd.exe started (nt4 has no job objects or taskkill) may keep running
# and hold the .out and .err open, so those files then stay until the next run's sweep retries.
# the password goes into a 0600 file in tmpfs that smbclient and net read with -A. it is never an
# argument, never in the environment and never printed.
# nt4 has no smb extended security, so every smbclient, smbcacls, rpcclient and net call turns spnego off ("client use
# spnego=no"); otherwise the session setup is refused before any credential is sent. ntlmv2 stays
# on, and lanman and plaintext logins are never enabled. nt4 sp6a computes a bad signing key after an
# ntlmv2 login, so the rpc calls on ipc$ must not require signing ("client ipc signing=if_required");
# "client signing" keeps its default.
set -u
umask 077

LOCK_DIR=${LANLORD_EXEC_DIR:-/var/lib/samba/private/exec}
TMP_DIR=${LANLORD_EXEC_TMP:-/dev/shm}
POLL=${LANLORD_EXEC_POLL:-1}
MAX_COMMAND=2000
LOG=${LANLORD_EXEC_LOG:-/var/lib/samba/private/exec.log}
LOCK_TRIES=${LANLORD_EXEC_LOCK_TRIES:-50}
LOG_MAX=${LANLORD_EXEC_LOG_MAX:-1048576}
SVC_EXE=${LANLORD_EXEC_SVC:-/usr/lib/lanlord/lanlord-svc.exe}
CHUNK=1048576
# the private work folder at the root of the system drive (found at run time): its name on the drive
# share, its windows path, and the acl (owner Administrators; full control for Administrators and SYSTEM
# only, inherited by files and subfolders). no P flag: nt4 predates it. --set replaces the whole dacl,
# so nothing inherited from the drive root stays
REMOTE_DIR=lanlord
WIN_DIR=
DRIVE=
LOGIN=
LOGIN_SID=
DIR_EXISTED=0
DIR_SDDL='O:BAD:(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)'
SMB_OPT=(--option='client min protocol=NT1' --option='client use spnego=no' --option='client ipc signing=if_required')

work=
addr=
machine=
run_id=
made_bat=0
made_service=0
start_pid=
final_sent=0
caller=cli
hash_command=0
audit=0
audit_result=error
started_ms=0

event() { printf 'LANLORD_EVENT %s\n' "$1"; }

# a json string holding only what is safe to quote
json_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//[[:cntrl:]]/ }
  printf '%s' "$s"
}

now_ms() {
  local t=${EPOCHREALTIME:-0.000000}
  t=${t/[.,]/}
  echo $((10#$t / 1000))
}

# appends the audit line (never the password); a log that cannot be written is only a warning
write_audit() {
  local ts shown ms line
  TZ=UTC printf -v ts '%(%Y-%m-%dT%H:%M:%SZ)T' -1
  shown=${command:0:$MAX_COMMAND}
  shown=${shown//[[:cntrl:]]/ }
  if ((hash_command)); then
    shown="sha256:$(printf '%s' "$command" | sha256sum | cut -d' ' -f1)"
  fi
  ms=$(($(now_ms) - started_ms))
  printf -v line '%s\t%s\t%s\t%s\t%s\t%s\t%d.%03d' "$ts" "$caller" "$machine" "${addr:--}" "$shown" "$audit_result" $((ms / 1000)) $((ms % 1000))
  (
    # busybox flock has no -w: wait by retrying -n, up to about 5 s
    for ((try = 0; try < LOCK_TRIES; try++)); do
      flock -n 7 && break
      sleep 0.1
    done
    ((try < LOCK_TRIES)) || exit 1
    if [[ -f $LOG ]] && (($(stat -c %s "$LOG") >= LOG_MAX)); then
      mv -f "$LOG" "$LOG.1" || exit 1
    fi
    printf '%s\n' "$line" >>"$LOG" || exit 1
    chmod 600 "$LOG"
  ) 7>"$LOG.lock" 2>/dev/null || echo "lanlord-exec: warning: could not write the audit log $LOG" >&2
}

# a request that is turned away; it is still audited
refuse() {
  audit_result=refused
  fail "$1"
}

fail() {
  if ((final_sent == 0)); then
    final_sent=1
    event "{\"error\":\"$(json_quote "$*")\"}"
  fi
  exit 1
}

# the last meaningful lines of a tool's output: samba's deprecation warnings, the extended security
# notice and blank lines are dropped so the real error is not cut off. "no output" when nothing is left
excerpt() {
  local text
  text=$(cat "$@" 2>/dev/null | grep -v -e 'lpcfg_do_global_parameter: WARNING' -e 'does not support EXTENDED_SECURITY' |
    grep -v '^[[:space:]]*$' | tail -n 3 | tr '\n' ' ' | head -c 300)
  echo "${text:-no output}"
}

smb() { smbclient "//$addr/ADMIN\$" -A "$work/auth" "${SMB_OPT[@]}" "$@"; }
# the drive share (C$ and so on) and the acl calls. the acl calls use sddl, which sets owner and dacl in
# one call. the domain sid is given so smbcacls does not look it up over ipc$ (nt4 refuses that); the
# builtin sids used here need none. the read-back is numeric for the same reason: no name lookup, so
# the output is plain sids
smbd() { smbclient "//$addr/$DRIVE\$" -A "$work/auth" "${SMB_OPT[@]}" "$@"; }
# acl SHARE PATH args
acl() {
  local share=$1 path=$2
  shift 2
  smbcacls "//$addr/$share" "$path" -A "$work/auth" "${SMB_OPT[@]}" --domain-sid=S-1-5-21-1-2-3 "$@"
}
rpcc() { rpcclient "$addr" -A "$work/auth" "${SMB_OPT[@]}" -c "$1"; }
rpc() {
  local verb=$1
  shift
  net rpc service "$verb" "$@" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}"
}

# delete the service and the temp files; runs on every way out
cleanup() {
  trap - EXIT INT TERM HUP
  # the audit line goes first: the cleanup talks to the machine, can take long when it does not
  # answer, and a run that is killed meanwhile must not lose its line
  ((audit)) && write_audit
  if [[ -n $start_pid ]]; then
    # the start runs in a session of its own, so the whole group goes
    kill -TERM -- "-$start_pid" 2>/dev/null || kill "$start_pid" 2>/dev/null
    wait "$start_pid" 2>/dev/null
  fi
  if [[ -n $work && -n $addr && -f $work/auth ]]; then
    if ((made_service)); then
      # a command that has not finished (timeout, signal, error) is still running: stopping the
      # service makes the helper end its cmd.exe; stopping a stopped service does no harm
      [[ -n ${final_rc:-} ]] || timeout 30 net rpc service stop "LANlordExec$run_id" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1
      rpc delete "LANlordExec$run_id" >/dev/null 2>&1
    fi
    if ((made_bat)); then
      local f=ll-$run_id
      local dels="del $f.exe; del $f.bat; del $f.cmd.bat; del $f.out; del $f.err; del $f.rc"
      smbd -c "cd $REMOTE_DIR; $dels" >/dev/null 2>&1
    fi
  fi
  [[ -n $work ]] && rm -rf "$work"
  return 0
}
trap cleanup EXIT
trap '((final_sent)) || audit_result=killed; exit 1' INT TERM HUP

# reads a flat json object of strings from $1 into the J array; nothing may follow the object
declare -A J=()
parse_json() {
  local t=$1 i=0 key c hex n
  skip() { while [[ -n ${t:i:1} && ${t:i:1} =~ [[:space:]] ]]; do i=$((i + 1)); done; }
  str() {
    local out=""
    i=$((i + 1))
    while :; do
      c=${t:i:1}
      [[ -z $c ]] && return 1
      case $c in
        '"') i=$((i + 1)); REPLY=$out; return 0 ;;
        '\')
          i=$((i + 1))
          c=${t:i:1}
          case $c in
            '"' | '\' | '/') out+=$c ;;
            n) out+=$'\n' ;;
            r) out+=$'\r' ;;
            t) out+=$'\t' ;;
            b) out+=$'\b' ;;
            f) out+=$'\f' ;;
            u)
              hex=${t:i+1:4}
              [[ $hex =~ ^[0-9a-fA-F]{4}$ ]] || return 1
              n=$((16#$hex))
              ((n > 0 && n < 128)) || return 1
              printf -v c '\\x%02x' "$n"
              printf -v c "$c"
              out+=$c
              i=$((i + 4))
              ;;
            *) return 1 ;;
          esac
          i=$((i + 1))
          ;;
        *) out+=$c; i=$((i + 1)) ;;
      esac
    done
  }
  skip
  [[ ${t:i:1} == '{' ]] || return 1
  i=$((i + 1))
  while :; do
    skip
    while [[ ${t:i:1} == ',' ]]; do i=$((i + 1)); skip; done
    if [[ ${t:i:1} == '}' ]]; then
      i=$((i + 1))
      skip
      [[ -z ${t:i:1} ]]
      return
    fi
    [[ ${t:i:1} == '"' ]] || return 1
    str || return 1
    key=$REPLY
    skip
    [[ ${t:i:1} == ':' ]] || return 1
    i=$((i + 1))
    skip
    # every value is a string; anything else, a nested object included, is refused
    [[ ${t:i:1} == '"' ]] || return 1
    str || return 1
    J[$key]=$REPLY
  done
}

# base64 on one line of $3 bytes of file $1 from byte offset $2
b64_from() { tail -c +"$(($2 + 1))" "$1" | head -c "$3" | base64 | tr -d '\n'; }

# the system drive letter, from the path of the ADMIN$ share (C:\WINNT gives C). the output is
# "netname: ADMIN$", "remark: ...", "path: C:\WINNT" and so on, one field a line
find_drive() {
  local line re='^[[:space:]]*path:[[:space:]]*([A-Za-z]):\\'
  DRIVE=
  rpcc 'netsharegetinfo ADMIN$' >"$work/share.log" 2>&1
  while IFS= read -r line; do
    line=${line%$'\r'}
    if [[ $line =~ $re ]]; then
      DRIVE=${BASH_REMATCH[1]^^}
      break
    fi
  done <"$work/share.log"
  [[ -n $DRIVE ]] || return 1
  WIN_DIR="$DRIVE:\\lanlord"
}

is_admin_sid() { [[ $1 == S-1-5-32-544 || $1 == S-1-5-18 ]]; }

# the sid of the login, looked up once; only for a plain account name (it goes into an rpcclient command)
login_sid() {
  [[ -n $LOGIN_SID ]] && return 0
  [[ $LOGIN =~ ^[A-Za-z0-9._\\-]{1,64}$ ]] || return 1
  LOGIN_SID=$(rpcc "lookupnames $LOGIN" 2>/dev/null | grep -m1 -oE 'S-1-5-21(-[0-9]+)+')
  [[ -n $LOGIN_SID ]]
}

# reads an acl: $1 share, $2 path, $3 its windows name. the output is numeric (no name lookup): a line
# OWNER:<sid>, and one ACL:<sid>:<type>/0x<flags>/0x<mask> line per ace (type 0 allowed, 1 denied),
# which go into ACL_OWNER and ACL_ACES. an smbcacls error is no acl: fail closed
ACL_OWNER=
ACL_ACES=()
read_acl() {
  local line
  acl "$1" "$2" --numeric >"$work/acl.out" 2>"$work/acl.err" ||
    fail "could not read the acl of $3 on $machine: $(excerpt "$work/acl.err" "$work/acl.out")"
  grep -q 'NT_STATUS_' "$work/acl.out" &&
    fail "could not read the acl of $3 on $machine: $(excerpt "$work/acl.out")"
  ACL_OWNER=
  ACL_ACES=()
  while IFS= read -r line; do
    line=${line%$'\r'}
    case $line in
      OWNER:*) ACL_OWNER=${line#OWNER:} ;;
      ACL:*) ACL_ACES+=("${line#ACL:}") ;;
    esac
  done <"$work/acl.out"
}

ACE_RE='^(S-[0-9]+(-[0-9]+)+):([0-9]+)/0x([0-9a-fA-F]+)/0x([0-9a-fA-F]+)$'

# the acl read last must be private: $1 its windows name, $2 = 1 lets the login's own sid own it (the
# files: nt4 gives a new file to the group Administrators for an administrator, but the account itself
# is no danger either). at least one ace, and every ace an allow ace for Administrators or SYSTEM
check_private() {
  local ace n=0 ok=1
  if ! is_admin_sid "$ACL_OWNER" && ! { [[ $2 == 1 ]] && login_sid && [[ $ACL_OWNER == "$LOGIN_SID" ]]; }; then
    ok=0
  fi
  for ace in "${ACL_ACES[@]}"; do
    n=$((n + 1))
    if [[ $ace =~ $ACE_RE ]] && is_admin_sid "${BASH_REMATCH[1]}" && ((BASH_REMATCH[3] == 0)); then
      continue
    fi
    ok=0
  done
  ((n > 0 && ok)) ||
    fail "$1 on $machine is not private (owner or acl is not administrators and system only); refusing to run"
}

# the root of the drive must not let anyone else delete children (rename our folder away), change
# permissions, take ownership or write everything: refused when an allow ace (not inherit-only) for an
# account other than Administrators, SYSTEM and Creator Owner holds delete child 0x40, write dac
# 0x40000, write owner 0x80000, generic all 0x10000000 or generic write 0x40000000 (this includes
# full control 0x1f01ff). change (0x1301bf) has none of them. the owner of the root must be Administrators
# or SYSTEM as well, as an owner can always change the acl
check_parent() {
  local ace why= n=0 root="$DRIVE:\\"
  read_acl "$DRIVE\$" '\' "$root"
  is_admin_sid "$ACL_OWNER" || why="its owner is ${ACL_OWNER:-unknown}"
  for ace in "${ACL_ACES[@]}"; do
    n=$((n + 1))
    if ! [[ $ace =~ $ACE_RE ]]; then
      why="an ace is not understood ($ace)"
      continue
    fi
    local sid=${BASH_REMATCH[1]} type=${BASH_REMATCH[3]}
    local flags=$((16#${BASH_REMATCH[4]})) mask=$((16#${BASH_REMATCH[5]}))
    ((type == 1)) && continue
    if ((type != 0)); then
      why="an ace of type $type is not understood"
      continue
    fi
    # inherit-only (0x8): it grants nothing on the root itself
    ((flags & 8)) && continue
    is_admin_sid "$sid" || [[ $sid == S-1-3-0 ]] && continue
    if ((mask & 0x500C0040)); then
      why="$sid holds 0x$(printf '%x' "$mask")"
    fi
  done
  ((n > 0)) || why="it has no permissions list"
  [[ -z $why ]] ||
    fail "the root $root of $machine is too open ($why): only Administrators, SYSTEM and Creator Owner" \
      "may hold full control, delete subfolders and files, change permissions or take ownership there;" \
      "tighten the permissions of $root (give others at most change) and retry"
}

# makes the work folder on the drive share. smbclient exits 0 even when a cd fails and then works in the
# root, so the output is checked for both. its exit code follows the last command, so a mkdir that
# failed (a collision or a denial) may exit non-zero and is not a connect failure. a collision means it
# already existed (DIR_EXISTED)
make_dir() {
  local mkdir_rc=0
  DIR_EXISTED=0
  smbd -c "mkdir $REMOTE_DIR" >"$work/mkdir.log" 2>&1 || mkdir_rc=$?
  local down='session setup failed|tree connect failed|Connection to .* failed|NT_STATUS_LOGON_FAILURE'
  down+='|NT_STATUS_IO_TIMEOUT|NT_STATUS_HOST_UNREACHABLE|NT_STATUS_CONNECTION|NT_STATUS_BAD_NETWORK_NAME'
  if grep -qE "$down" "$work/mkdir.log" ||
    { ((mkdir_rc)) && ! grep -q 'mkdir failed' "$work/mkdir.log"; }; then
    fail "could not connect to $machine: $(excerpt "$work/mkdir.log")"
  elif grep -q 'NT_STATUS_OBJECT_NAME_COLLISION' "$work/mkdir.log"; then
    DIR_EXISTED=1
  elif grep -q 'NT_STATUS_' "$work/mkdir.log"; then
    fail "could not create $WIN_DIR on $machine: $(excerpt "$work/mkdir.log")"
  fi
}

# the lock: owner and dacl, set in one call, and checked from the output
lock_dir() {
  acl "$DRIVE\$" "$REMOTE_DIR" --sddl --set "$DIR_SDDL" >"$work/acl.log" 2>&1 ||
    fail "could not lock $WIN_DIR on $machine to administrators: $(excerpt "$work/acl.log")"
  grep -q -e 'NT_STATUS_' -e 'ERROR' "$work/acl.log" &&
    fail "could not lock $WIN_DIR on $machine to administrators: $(excerpt "$work/acl.log")"
}

# a target that is not a folder (a file of that name) is refused
check_folder() {
  smbd -c "cd $REMOTE_DIR" >"$work/cd.log" 2>&1
  if grep -q 'NT_STATUS_' "$work/cd.log"; then
    fail "$WIN_DIR on $machine is not a folder; delete it on $machine and retry"
  fi
}

# makes the work folder and locks it to Administrators and SYSTEM; fails closed: nothing is uploaded
# unless the acl read back is exactly that. the owner is set too: an owner keeps WRITE_DAC, so a user
# who made the folder first could otherwise open it again; for that reason a folder that already exists
# and is owned by anyone else is refused instead of taken over
prepare_dir() {
  make_dir
  if ((DIR_EXISTED)); then
    read_acl "$DRIVE\$" "$REMOTE_DIR" "$WIN_DIR"
    is_admin_sid "$ACL_OWNER" ||
      fail "$WIN_DIR on $machine already exists and is owned by ${ACL_OWNER:-unknown}, not" \
        "administrators; delete $WIN_DIR on $machine and retry"
    check_folder
    lock_dir
  else
    # a new folder inherits the drive root's acl: lock it at once, nothing in between
    lock_dir
    check_folder
  fi
  read_acl "$DRIVE\$" "$REMOTE_DIR" "$WIN_DIR"
  check_private "$WIN_DIR" 0
}

# the work folder is verified: files that earlier runs left in it go (a run that timed out leaves its
# .out and .err when the program still running held them open). the names come from a listing and only
# ll-<8 hex>.<known extension> is deleted, one del each, so no wildcard can reach anything else; a file
# that is still held fails to delete, which is ignored: a later run gets it. this run's files are not
# there yet, they are uploaded after this
sweep_folder() {
  local line name dels= re='^[[:space:]]*(ll-[0-9a-f]{8}\.(exe|bat|cmd\.bat|out|err|rc))[[:space:]]'
  smbd -c "cd $REMOTE_DIR; ls ll-*" >"$work/ls.log" 2>&1
  while IFS= read -r line; do
    line=${line%$'\r'}
    if [[ $line =~ $re ]]; then
      name=${BASH_REMATCH[1]}
      dels+="; del $name"
    fi
  done <"$work/ls.log"
  [[ -z $dels ]] || smbd -c "cd $REMOTE_DIR$dels" >/dev/null 2>&1 || true
}

# right before the service is created: the root, the folder and the three uploaded files again
verify_upload() {
  local f
  check_parent
  read_acl "$DRIVE\$" "$REMOTE_DIR" "$WIN_DIR"
  check_private "$WIN_DIR" 0
  for f in "$bat.exe" "$bat.bat" "$bat.cmd.bat"; do
    read_acl "$DRIVE\$" "$REMOTE_DIR\\$f" "$WIN_DIR\\$f"
    check_private "$WIN_DIR\\$f" 1
  done
}

# service names left by earlier runs, and their files, are removed
sweep_stale() {
  local names svc n=0
  names=$(rpc list 2>/dev/null | grep -o 'LANlordExec[0-9a-f]\{8\}' | sort -u)
  for svc in $names; do
    timeout 30 net rpc service stop "$svc" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1
    rpc delete "$svc" >/dev/null 2>&1
    n=$((n + 1))
  done
  # only exact ll-<8 chars> names go. earlier versions used the root of %SystemRoot% and Temp (a missing
  # Temp makes the cd fail and the dels run in the root), and Temp\lanlord before the drive root
  local root=ll-????????
  local dels="del $root.exe; del $root.bat; del $root.cmd.bat; del $root.out; del $root.err; del $root.rc"
  smb -c "$dels; cd Temp; $dels; cd lanlord; $dels" >/dev/null 2>&1
  # the work folder is swept by sweep_folder in a run, after it is verified; a sweep has no verification
  [[ $mode == sweep && -n $DRIVE ]] && smbd -c "cd $REMOTE_DIR; $dels" >/dev/null 2>&1
  SWEPT=$n
}

mode=${1:-}
[[ $mode == run || $mode == sweep ]] || fail "usage: lanlord-exec run|sweep --machine NAME [--address ADDR] [--timeout N]"
shift
timeout=120
while (($#)); do
  case $1 in
    --machine) machine=${2:-}; shift 2 || fail "--machine needs a value" ;;
    --address) addr=${2:-}; shift 2 || fail "--address needs a value" ;;
    --timeout) timeout=${2:-}; shift 2 || fail "--timeout needs a value" ;;
    --hash-command) hash_command=1; shift ;;
    *) fail "unknown argument $1" ;;
  esac
done
[[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$ ]] || fail "the machine name is not valid"
if [[ -n $addr ]]; then
  [[ $addr =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || fail "the address is not valid"
  for octet in "${BASH_REMATCH[@]:1}"; do
    ((10#$octet <= 255)) || fail "the address is not valid"
  done
fi
[[ $timeout =~ ^[0-9]{1,3}$ ]] && ((10#$timeout >= 1 && 10#$timeout <= 900)) || fail "the timeout is not valid (1 to 900)"
timeout=$((10#$timeout))
machine=${machine^^}

# a scratch folder a killed run left behind (the password file is in it) is older than the longest
# run (900 s) plus a margin; a younger one may belong to a run that is still going
find "$TMP_DIR" -maxdepth 1 -name 'lanlord-exec.*' -type d -mmin +20 -exec rm -rf {} + 2>/dev/null

work=$(mktemp -d "$TMP_DIR/lanlord-exec.XXXXXX") || fail "no scratch folder"

# the request: a nul byte would vanish in a shell variable, so it is looked for in the file
cat >"$work/in"
if [[ $(tr -d '\0' <"$work/in" | wc -c) != "$(wc -c <"$work/in")" ]]; then
  fail "the request holds a nul byte"
fi
parse_json "$(cat "$work/in")" || fail "the request is not a json object of strings"
rm -f "$work/in"
user=${J[user]:-}
password=${J[password]:-}
command=${J[command]:-}
caller=${J[caller]:-cli}
unset 'J[password]'
[[ -n $user && -n $password ]] || fail "user and password are needed"
if [[ $user == *[$'\r\n']* || $password == *[$'\r\n']* ]]; then
  fail "the credentials hold a line break"
fi
[[ $caller =~ ^[A-Za-z0-9._@-]{1,64}$ ]] || fail "the caller is not valid"
if [[ $mode == run ]]; then
  started_ms=$(now_ms)
  audit=1
  [[ -n $command ]] || refuse "the command is empty"
  [[ $command != *[$'\r\n']* ]] || refuse "the command holds a line break"
  ((${#command} <= MAX_COMMAND)) || refuse "the command is longer than $MAX_COMMAND characters"
  [[ -f $SVC_EXE ]] || fail "the service helper $SVC_EXE is missing from the image; update the nt4-domain image"
fi

# the password file; a DOMAIN\user name is split the way smbclient wants it
{
  if [[ $user == *\\* ]]; then
    printf 'domain=%s\n' "${user%%\\*}"
    printf 'username=%s\n' "${user#*\\}"
  else
    printf 'username=%s\n' "$user"
  fi
  printf 'password=%s\n' "$password"
} >"$work/auth"
chmod 600 "$work/auth"
password=
LOGIN=$user
user=

# one run per machine
mkdir -p "$LOCK_DIR" || fail "no lock folder"
exec 9>"$LOCK_DIR/$machine.lock"
flock -n 9 || fail "another command is already running on $machine"

if [[ -z $addr ]]; then
  addr=$(nmblookup -- "$machine" 2>/dev/null | grep -m1 -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
  [[ -n $addr ]] || fail "$machine does not answer to its name"
fi
# the sweep clears every LANlordExec service and ll-* file at the address, so the address is locked too
exec 8>"$LOCK_DIR/addr-$addr.lock"
flock -n 8 || fail "another command is already running at $addr"

# the drive is needed to run; a sweep without it only skips the drive root
if [[ $mode == run ]]; then
  find_drive || fail "could not find the system drive of $machine from its ADMIN\$ share: $(excerpt "$work/share.log")"
else
  find_drive || true
fi
sweep_stale
if [[ $mode == sweep ]]; then
  event "{\"swept\":$SWEPT}"
  final_sent=1
  exit 0
fi

check_parent
prepare_dir
sweep_folder

run_id=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
bat=ll-$run_id
# the command goes into an inner .bat as it is, so %SystemRoot% and the like expand as at a prompt and
# a chain (a & b) is redirected as a whole. batch-file rules apply, though: a for loop variable needs
# %%i, not %i. the outer .bat calls it with the output redirected and then writes the exit code
{
  printf '@echo off\r\n%s\r\n' "$command"
} >"$work/$bat.cmd.bat"
{
  printf '@echo off\r\n'
  printf 'call %s\\%s.cmd.bat > %s\\%s.out' "$WIN_DIR" "$bat" "$WIN_DIR" "$bat"
  printf ' 2> %s\\%s.err\r\n' "$WIN_DIR" "$bat"
  printf 'echo %%ERRORLEVEL%% > %s\\%s.rc\r\n' "$WIN_DIR" "$bat"
} >"$work/$bat.bat"
made_bat=1
puts="put $work/$bat.cmd.bat $bat.cmd.bat; put $work/$bat.bat $bat.bat; put $SVC_EXE $bat.exe"
smbd -c "cd $REMOTE_DIR; $puts" >"$work/put.log" 2>&1 ||
  fail "could not copy the script to $machine: $(excerpt "$work/put.log")"
# the exit code follows the last command only, so any error line counts (a failed cd included)
grep -q 'NT_STATUS_' "$work/put.log" &&
  fail "could not copy the script to $machine: $WIN_DIR is not usable: $(excerpt "$work/put.log")"

verify_upload

made_service=1
rpc create "LANlordExec$run_id" "LANlord exec" \
  "\"$WIN_DIR\\$bat.exe\" $WIN_DIR\\$bat.bat" >"$work/create.log" 2>&1 ||
  {
    if grep -q 'NT_STATUS_IO_TIMEOUT' "$work/create.log"; then
      fail "the service manager on $machine is busy (a previous run may still be starting); try again in a minute"
    fi
    fail "could not create the service on $machine: $(excerpt "$work/create.log")"
  }

# the helper answers the service manager at once, so the start returns quickly; an older failure mode
# (error 1053 after a while, the command still running) is tolerated: the start is in the background
# and the run is watched through the .rc file
setsid bash -c 'log=$1 rcfile=$2; shift 2; "$@" >"$log" 2>&1; echo $? >"$rcfile"' _ \
  "$work/start.log" "$work/start.rc" \
  net rpc service start "LANlordExec$run_id" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1 &
start_pid=$!

emit_new() {
  local stream=$1 file=$2 var=$3 size data off n
  [[ -f $file ]] || return 0
  size=$(wc -c <"$file")
  off=${!var}
  # at most CHUNK raw bytes to a line
  while ((size > off)); do
    n=$((size - off))
    ((n <= CHUNK)) || n=$CHUNK
    data=$(b64_from "$file" "$off" "$n")
    off=$((off + n))
    printf -v "$var" '%s' "$off"
    event "{\"stream\":\"$stream\",\"data\":\"$data\"}"
  done
}

off_out=0
off_err=0
final_rc=
bad_rc=0
SECONDS=0
while :; do
  rm -f "$work/rc" "$work/out" "$work/err"
  smbd -c "cd $REMOTE_DIR; get $bat.rc $work/rc; get $bat.out $work/out; get $bat.err $work/err" >/dev/null 2>&1
  if [[ -s $work/rc ]]; then
    final_rc=$(tr -dc '0-9' <"$work/rc")
    if [[ -z $final_rc ]]; then
      # read it once more before giving up: it may have been caught half written
      bad_rc=$((bad_rc + 1))
      ((bad_rc < 2)) || fail "the exit code file on $machine holds no number"
    fi
  fi
  emit_new out "$work/out" off_out
  emit_new err "$work/err" off_err
  [[ -n $final_rc ]] && break
  if [[ -f $work/start.rc ]] && [[ $(cat "$work/start.rc") != 0 ]] &&
    ! grep -qiE '1053|REQUEST_TIMEOUT|did not respond|NT_STATUS_IO_TIMEOUT' "$work/start.log"; then
    fail "could not start the service on $machine: $(excerpt "$work/start.log")"
  fi
  if ((SECONDS >= timeout)); then
    final_sent=1
    audit_result=timed_out
    event '{"timed_out":true}'
    exit 0
  fi
  sleep "$POLL"
done
final_sent=1
audit_result=$final_rc
event "{\"exit\":$final_rc}"
exit 0
