#!/bin/bash
# runs one command on a domain member over smb1, psexec style: nothing is installed on the machine.
# a .bat and a small service helper (lanlord-svc.exe, built into the image) go into ADMIN$\Temp, a
# service started from the helper runs the .bat with cmd.exe, and the output is streamed back.
#   lanlord-exec run --machine NAME [--address ADDR] --timeout N [--hash-command]
#                             stdin: {"user":"...","password":"...","command":"...","caller":"..."}
#                             caller is optional (letters, digits and ._@- only; "cli" when absent)
#   lanlord-exec sweep --machine NAME [--address ADDR]
#                             stdin: {"user":"...","password":"..."}
#                             remove services and files that an earlier run left behind
# stdout is one json object per line after the LANLORD_EVENT marker:
#   {"stream":"out"|"err","data":"<base64>"}   new bytes of the command's output
#   {"exit":N} | {"timed_out":true} | {"error":"..."}   the last line of a run
# {"stream":...} lines carry at most 1 MiB of raw bytes each; more output comes as several lines.
# every run appends one tab separated line to the audit log (LANLORD_EXEC_LOG, default
# /var/lib/samba/private/exec.log, 0600): time, caller, machine, address, the command (or
# sha256:<hex> with --hash-command), the exit code or timed_out, error, killed (a signal) or refused (a bad command), and the duration. the
# password is never written. the log rotates at 1 MiB and keeps one .1; when it cannot be written
# the run still completes and stderr gets a warning.
# a free-form command must not use a plain "exit N": it ends the outer cmd.exe, so the exit code
# is never written and the run shows as timed_out. nt4 has no "exit /b"; use "cmd /c exit N" to
# set a code. core refuses a command in which any part, split at &, && || and parentheses and
# after a leading @, if ... or do, starts with exit; a single | does not split, as the right side of
# a pipe runs in a child cmd.
# a command that outlives its timeout is killed: the service is stopped first, and the helper ends
# its cmd.exe. programs that cmd.exe started (nt4 has no job objects or taskkill) may keep running
# and hold the .out and .err open, so those files then stay until the next run's sweep retries.
# the password goes into a 0600 file in tmpfs that smbclient and net read with -A. it is never an
# argument, never in the environment and never printed.
# nt4 has no smb extended security, so every smbclient and net call turns spnego off ("client use
# spnego=no"); otherwise the session setup is refused before any credential is sent. ntlmv2 stays
# on, and lanman and plaintext logins are never enabled. nt4 sp6a computes a bad signing key after an
# ntlmv2 login, so the rpc calls on ipc$ must not require signing ("client ipc signing=if_required");
# "client signing" keeps its default.
set -u
umask 077

LOCK_DIR=${LANLORD_EXEC_DIR:-/var/lib/samba/private/exec}
TMP_DIR=${LANLORD_EXEC_TMP:-/dev/shm}
POLL=${LANLORD_EXEC_POLL:-1}
MAX_COMMAND=2000
LOG=${LANLORD_EXEC_LOG:-/var/lib/samba/private/exec.log}
LOCK_TRIES=${LANLORD_EXEC_LOCK_TRIES:-50}
LOG_MAX=${LANLORD_EXEC_LOG_MAX:-1048576}
SVC_EXE=${LANLORD_EXEC_SVC:-/usr/lib/lanlord/lanlord-svc.exe}
CHUNK=1048576
SMB_OPT=(--option='client min protocol=NT1' --option='client use spnego=no' --option='client ipc signing=if_required')

work=
addr=
machine=
run_id=
made_bat=0
made_service=0
start_pid=
final_sent=0
caller=cli
hash_command=0
audit=0
audit_result=error
started_ms=0

event() { printf 'LANLORD_EVENT %s\n' "$1"; }

# a json string holding only what is safe to quote
json_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//[[:cntrl:]]/ }
  printf '%s' "$s"
}

now_ms() {
  local t=${EPOCHREALTIME:-0.000000}
  t=${t/[.,]/}
  echo $((10#$t / 1000))
}

# appends the audit line (never the password); a log that cannot be written is only a warning
write_audit() {
  local ts shown ms line
  TZ=UTC printf -v ts '%(%Y-%m-%dT%H:%M:%SZ)T' -1
  shown=${command:0:$MAX_COMMAND}
  shown=${shown//[[:cntrl:]]/ }
  if ((hash_command)); then
    shown="sha256:$(printf '%s' "$command" | sha256sum | cut -d' ' -f1)"
  fi
  ms=$(($(now_ms) - started_ms))
  printf -v line '%s\t%s\t%s\t%s\t%s\t%s\t%d.%03d' "$ts" "$caller" "$machine" "${addr:--}" "$shown" "$audit_result" $((ms / 1000)) $((ms % 1000))
  (
    # busybox flock has no -w: wait by retrying -n, up to about 5 s
    for ((try = 0; try < LOCK_TRIES; try++)); do
      flock -n 7 && break
      sleep 0.1
    done
    ((try < LOCK_TRIES)) || exit 1
    if [[ -f $LOG ]] && (($(stat -c %s "$LOG") >= LOG_MAX)); then
      mv -f "$LOG" "$LOG.1" || exit 1
    fi
    printf '%s\n' "$line" >>"$LOG" || exit 1
    chmod 600 "$LOG"
  ) 7>"$LOG.lock" 2>/dev/null || echo "lanlord-exec: warning: could not write the audit log $LOG" >&2
}

# a request that is turned away; it is still audited
refuse() {
  audit_result=refused
  fail "$1"
}

fail() {
  if ((final_sent == 0)); then
    final_sent=1
    event "{\"error\":\"$(json_quote "$1")\"}"
  fi
  exit 1
}

# the last meaningful lines of a tool's output: samba's deprecation warnings, the extended security
# notice and blank lines are dropped so the real error is not cut off
excerpt() {
  grep -v -e 'lpcfg_do_global_parameter: WARNING' -e 'does not support EXTENDED_SECURITY' "$1" 2>/dev/null |
    grep -v '^[[:space:]]*$' | tail -n 3 | tr '\n' ' ' | head -c 300
}

smb() { smbclient "//$addr/ADMIN\$" -A "$work/auth" "${SMB_OPT[@]}" "$@"; }
rpc() {
  local verb=$1
  shift
  net rpc service "$verb" "$@" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}"
}

# delete the service and the temp files; runs on every way out
cleanup() {
  trap - EXIT INT TERM HUP
  # the audit line goes first: the cleanup talks to the machine, can take long when it does not
  # answer, and a run that is killed meanwhile must not lose its line
  ((audit)) && write_audit
  if [[ -n $start_pid ]]; then
    # the start runs in a session of its own, so the whole group goes
    kill -TERM -- "-$start_pid" 2>/dev/null || kill "$start_pid" 2>/dev/null
    wait "$start_pid" 2>/dev/null
  fi
  if [[ -n $work && -n $addr && -f $work/auth ]]; then
    if ((made_service)); then
      # a command that has not finished (timeout, signal, error) is still running: stopping the
      # service makes the helper end its cmd.exe; stopping a stopped service does no harm
      [[ -n ${final_rc:-} ]] || timeout 30 net rpc service stop "LANlordExec$run_id" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1
      rpc delete "LANlordExec$run_id" >/dev/null 2>&1
    fi
    if ((made_bat)); then
      smb -c "cd Temp; del ll-$run_id.exe; del ll-$run_id.bat; del ll-$run_id.cmd.bat; del ll-$run_id.out; del ll-$run_id.err; del ll-$run_id.rc" >/dev/null 2>&1
    fi
  fi
  [[ -n $work ]] && rm -rf "$work"
  return 0
}
trap cleanup EXIT
trap '((final_sent)) || audit_result=killed; exit 1' INT TERM HUP

# reads a flat json object of strings from $1 into the J array; nothing may follow the object
declare -A J=()
parse_json() {
  local t=$1 i=0 key c hex n
  skip() { while [[ -n ${t:i:1} && ${t:i:1} =~ [[:space:]] ]]; do i=$((i + 1)); done; }
  str() {
    local out=""
    i=$((i + 1))
    while :; do
      c=${t:i:1}
      [[ -z $c ]] && return 1
      case $c in
        '"') i=$((i + 1)); REPLY=$out; return 0 ;;
        '\')
          i=$((i + 1))
          c=${t:i:1}
          case $c in
            '"' | '\' | '/') out+=$c ;;
            n) out+=$'\n' ;;
            r) out+=$'\r' ;;
            t) out+=$'\t' ;;
            b) out+=$'\b' ;;
            f) out+=$'\f' ;;
            u)
              hex=${t:i+1:4}
              [[ $hex =~ ^[0-9a-fA-F]{4}$ ]] || return 1
              n=$((16#$hex))
              ((n > 0 && n < 128)) || return 1
              printf -v c '\\x%02x' "$n"
              printf -v c "$c"
              out+=$c
              i=$((i + 4))
              ;;
            *) return 1 ;;
          esac
          i=$((i + 1))
          ;;
        *) out+=$c; i=$((i + 1)) ;;
      esac
    done
  }
  skip
  [[ ${t:i:1} == '{' ]] || return 1
  i=$((i + 1))
  while :; do
    skip
    while [[ ${t:i:1} == ',' ]]; do i=$((i + 1)); skip; done
    if [[ ${t:i:1} == '}' ]]; then
      i=$((i + 1))
      skip
      [[ -z ${t:i:1} ]]
      return
    fi
    [[ ${t:i:1} == '"' ]] || return 1
    str || return 1
    key=$REPLY
    skip
    [[ ${t:i:1} == ':' ]] || return 1
    i=$((i + 1))
    skip
    # every value is a string; anything else, a nested object included, is refused
    [[ ${t:i:1} == '"' ]] || return 1
    str || return 1
    J[$key]=$REPLY
  done
}

# base64 on one line of $3 bytes of file $1 from byte offset $2
b64_from() { tail -c +"$(($2 + 1))" "$1" | head -c "$3" | base64 | tr -d '\n'; }

# service names left by earlier runs, and their files, are removed
sweep_stale() {
  local names svc n=0
  names=$(rpc list 2>/dev/null | grep -o 'LANlordExec[0-9a-f]\{8\}' | sort -u)
  for svc in $names; do
    timeout 30 net rpc service stop "$svc" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1
    rpc delete "$svc" >/dev/null 2>&1
    n=$((n + 1))
  done
  smb -c 'cd Temp; del ll-*.exe; del ll-*.bat; del ll-*.out; del ll-*.err; del ll-*.rc' >/dev/null 2>&1
  SWEPT=$n
}

mode=${1:-}
[[ $mode == run || $mode == sweep ]] || fail "usage: lanlord-exec run|sweep --machine NAME [--address ADDR] [--timeout N]"
shift
timeout=120
while (($#)); do
  case $1 in
    --machine) machine=${2:-}; shift 2 || fail "--machine needs a value" ;;
    --address) addr=${2:-}; shift 2 || fail "--address needs a value" ;;
    --timeout) timeout=${2:-}; shift 2 || fail "--timeout needs a value" ;;
    --hash-command) hash_command=1; shift ;;
    *) fail "unknown argument $1" ;;
  esac
done
[[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$ ]] || fail "the machine name is not valid"
if [[ -n $addr ]]; then
  [[ $addr =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || fail "the address is not valid"
  for octet in "${BASH_REMATCH[@]:1}"; do
    ((10#$octet <= 255)) || fail "the address is not valid"
  done
fi
[[ $timeout =~ ^[0-9]{1,3}$ ]] && ((10#$timeout >= 1 && 10#$timeout <= 900)) || fail "the timeout is not valid (1 to 900)"
timeout=$((10#$timeout))
machine=${machine^^}

# a scratch folder a killed run left behind (the password file is in it) is older than the longest
# run (900 s) plus a margin; a younger one may belong to a run that is still going
find "$TMP_DIR" -maxdepth 1 -name 'lanlord-exec.*' -type d -mmin +20 -exec rm -rf {} + 2>/dev/null

work=$(mktemp -d "$TMP_DIR/lanlord-exec.XXXXXX") || fail "no scratch folder"

# the request: a nul byte would vanish in a shell variable, so it is looked for in the file
cat >"$work/in"
if [[ $(tr -d '\0' <"$work/in" | wc -c) != "$(wc -c <"$work/in")" ]]; then
  fail "the request holds a nul byte"
fi
parse_json "$(cat "$work/in")" || fail "the request is not a json object of strings"
rm -f "$work/in"
user=${J[user]:-}
password=${J[password]:-}
command=${J[command]:-}
caller=${J[caller]:-cli}
unset 'J[password]'
[[ -n $user && -n $password ]] || fail "user and password are needed"
if [[ $user == *[$'\r\n']* || $password == *[$'\r\n']* ]]; then
  fail "the credentials hold a line break"
fi
[[ $caller =~ ^[A-Za-z0-9._@-]{1,64}$ ]] || fail "the caller is not valid"
if [[ $mode == run ]]; then
  started_ms=$(now_ms)
  audit=1
  [[ -n $command ]] || refuse "the command is empty"
  [[ $command != *[$'\r\n']* ]] || refuse "the command holds a line break"
  ((${#command} <= MAX_COMMAND)) || refuse "the command is longer than $MAX_COMMAND characters"
  [[ -f $SVC_EXE ]] || fail "the service helper $SVC_EXE is missing from the image; update the nt4-domain image"
fi

# the password file; a DOMAIN\user name is split the way smbclient wants it
{
  if [[ $user == *\\* ]]; then
    printf 'domain=%s\n' "${user%%\\*}"
    printf 'username=%s\n' "${user#*\\}"
  else
    printf 'username=%s\n' "$user"
  fi
  printf 'password=%s\n' "$password"
} >"$work/auth"
chmod 600 "$work/auth"
password=
user=

# one run per machine
mkdir -p "$LOCK_DIR" || fail "no lock folder"
exec 9>"$LOCK_DIR/$machine.lock"
flock -n 9 || fail "another command is already running on $machine"

if [[ -z $addr ]]; then
  addr=$(nmblookup -- "$machine" 2>/dev/null | grep -m1 -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
  [[ -n $addr ]] || fail "$machine does not answer to its name"
fi
# the sweep clears every LANlordExec service and ll-* file at the address, so the address is locked too
exec 8>"$LOCK_DIR/addr-$addr.lock"
flock -n 8 || fail "another command is already running at $addr"

sweep_stale
if [[ $mode == sweep ]]; then
  event "{\"swept\":$SWEPT}"
  final_sent=1
  exit 0
fi

run_id=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
bat=ll-$run_id
# the command goes into an inner .bat as it is, so %SystemRoot% and the like expand as at a prompt and
# a chain (a & b) is redirected as a whole. batch-file rules apply, though: a for loop variable needs
# %%i, not %i. the outer .bat calls it with the output redirected and then writes the exit code
{
  printf '@echo off\r\n%s\r\n' "$command"
} >"$work/$bat.cmd.bat"
{
  printf '@echo off\r\n'
  printf 'call %%SystemRoot%%\\Temp\\%s.cmd.bat > %%SystemRoot%%\\Temp\\%s.out 2> %%SystemRoot%%\\Temp\\%s.err\r\n' "$bat" "$bat" "$bat"
  printf 'echo %%ERRORLEVEL%% > %%SystemRoot%%\\Temp\\%s.rc\r\n' "$bat"
} >"$work/$bat.bat"
made_bat=1
smb -c "cd Temp; put $work/$bat.cmd.bat $bat.cmd.bat; put $work/$bat.bat $bat.bat; put $SVC_EXE $bat.exe" >"$work/put.log" 2>&1 || fail "could not copy the script to $machine: $(excerpt "$work/put.log")"

made_service=1
rpc create "LANlordExec$run_id" "LANlord exec" \
  "\"%SystemRoot%\\Temp\\$bat.exe\" %SystemRoot%\\Temp\\$bat.bat" >"$work/create.log" 2>&1 ||
  {
    if grep -q 'NT_STATUS_IO_TIMEOUT' "$work/create.log"; then
      fail "the service manager on $machine is busy (a previous run may still be starting); try again in a minute"
    fi
    fail "could not create the service on $machine: $(excerpt "$work/create.log")"
  }

# the helper answers the service manager at once, so the start returns quickly; an older failure mode
# (error 1053 after a while, the command still running) is tolerated: the start is in the background
# and the run is watched through the .rc file
setsid bash -c 'log=$1 rcfile=$2; shift 2; "$@" >"$log" 2>&1; echo $? >"$rcfile"' _ \
  "$work/start.log" "$work/start.rc" \
  net rpc service start "LANlordExec$run_id" -S "$addr" -A "$work/auth" "${SMB_OPT[@]}" >/dev/null 2>&1 &
start_pid=$!

emit_new() {
  local stream=$1 file=$2 var=$3 size data off n
  [[ -f $file ]] || return 0
  size=$(wc -c <"$file")
  off=${!var}
  # at most CHUNK raw bytes to a line
  while ((size > off)); do
    n=$((size - off))
    ((n <= CHUNK)) || n=$CHUNK
    data=$(b64_from "$file" "$off" "$n")
    off=$((off + n))
    printf -v "$var" '%s' "$off"
    event "{\"stream\":\"$stream\",\"data\":\"$data\"}"
  done
}

off_out=0
off_err=0
final_rc=
bad_rc=0
SECONDS=0
while :; do
  rm -f "$work/rc" "$work/out" "$work/err"
  smb -c "cd Temp; get $bat.rc $work/rc; get $bat.out $work/out; get $bat.err $work/err" >/dev/null 2>&1
  if [[ -s $work/rc ]]; then
    final_rc=$(tr -dc '0-9' <"$work/rc")
    if [[ -z $final_rc ]]; then
      # read it once more before giving up: it may have been caught half written
      bad_rc=$((bad_rc + 1))
      ((bad_rc < 2)) || fail "the exit code file on $machine holds no number"
    fi
  fi
  emit_new out "$work/out" off_out
  emit_new err "$work/err" off_err
  [[ -n $final_rc ]] && break
  if [[ -f $work/start.rc ]] && [[ $(cat "$work/start.rc") != 0 ]] &&
    ! grep -qiE '1053|REQUEST_TIMEOUT|did not respond|NT_STATUS_IO_TIMEOUT' "$work/start.log"; then
    fail "could not start the service on $machine: $(excerpt "$work/start.log")"
  fi
  if ((SECONDS >= timeout)); then
    final_sent=1
    audit_result=timed_out
    event '{"timed_out":true}'
    exit 0
  fi
  sleep "$POLL"
done
final_sent=1
audit_result=$final_rc
event "{\"exit\":$final_rc}"
exit 0
