#!/bin/bash
# manages samba accounts. a password is read from stdin, never from arguments.
#   lanlord-user add NAME [admin|user] [software]  create the account or set its password; admin makes it a domain
#                             admin, software lets it write to the software share without being one
#   lanlord-user sync         rebuild the software admins group (domain admins and the software list)
#   lanlord-user admin        set the password of the domain administrator
#   lanlord-user delete NAME  remove the account
#   lanlord-user machine NAME create a machine account so an nt4 computer can join without creating it
#   lanlord-user list         list the accounts
set -eu
cmd=${1:-}
name=${2:-}

valid() {
  case "$1" in
    '' | *[!a-z0-9_.-]* | [!a-z]*) echo "invalid user name: $1" >&2; exit 2 ;;
  esac
}

read_password() {
  IFS= read -r password || true
  [[ -n $password ]] || { echo "the password is empty" >&2; exit 2; }
}


# domain admin membership is the unix group domadmins; it is also written to a file in the
# persistent samba directory so entrypoint.sh can restore it when the container is replaced
set_role() {
  local list=/var/lib/samba/private/domadmins
  touch "$list"
  if [[ $2 == admin ]]; then
    usermod -aG domadmins "$1"
    grep -qx "$1" "$list" || echo "$1" >> "$list"
  else
    gpasswd -d "$1" domadmins >/dev/null 2>&1 || true
    sed -i "/^$1\$/d" "$list"
  fi
}

# software admins are the domain admins plus the names in the softadmins file; the group is
# rebuilt from both lists so removing a user from either takes effect
sync_software() {
  local private=/var/lib/samba/private want have
  touch "$private/domadmins" "$private/softadmins"
  want=$(cat "$private/domadmins" "$private/softadmins" | sort -u)
  have=$(getent group softadmins | cut -d: -f4 | tr ',' '\n')
  for member in $have; do
    grep -qx "$member" <<<"$want" || gpasswd -d "$member" softadmins >/dev/null 2>&1 || true
  done
  for member in $want; do
    if id "$member" >/dev/null 2>&1; then usermod -aG softadmins "$member"; fi
  done
}

set_software() {
  local list=/var/lib/samba/private/softadmins
  touch "$list"
  if [[ ${1:-} == software ]]; then
    grep -qx "$2" "$list" || echo "$2" >> "$list"
  else
    sed -i "/^$2\$/d" "$list"
  fi
}

# each user's home folder, used by windows 9x roaming profiles
make_home() {
  install -d -o "$1" -g domusers -m 0700 "/var/lib/samba/homes/$1"
}

case "$cmd" in
  add)
    valid "$name"
    read_password
    created=
    if ! id "$name" >/dev/null 2>&1; then
      useradd -M -g domusers -s /usr/sbin/nologin "$name"
      created=1
    fi
    printf '%s\n%s\n' "$password" "$password" | smbpasswd -s -a "$name" >/dev/null
    set_role "$name" "${3:-user}"
    set_software "${4:-}" "$name"
    sync_software
    make_home "$name"
    if [[ -n $created ]]; then echo "created $name"; else echo "updated $name"; fi
    ;;
  admin)
    read_password
    printf '%s\n%s\n' "$password" "$password" | smbpasswd -s -a root >/dev/null
    echo "set the administrator password"
    ;;
  machine)
    valid "$name"
    # the unix account of a computer ends in a dollar sign; its first password is its own name
    if ! id "${name}\$" >/dev/null 2>&1; then
      useradd --badname -M -g machines -d /dev/null -s /usr/sbin/nologin "${name}\$"
    fi
    if pdbedit -L -u "${name}\$" >/dev/null 2>&1; then
      echo "exists $name"
    else
      smbpasswd -a -m "$name" >/dev/null
      echo "created machine $name"
    fi
    ;;
  delete)
    valid "$name"
    smbpasswd -x "$name" >/dev/null 2>&1 || true
    set_role "$name" user
    set_software none "$name"
    sync_software
    userdel "$name" >/dev/null 2>&1 || true
    echo "deleted $name"
    ;;
  sync)
    sync_software
    ;;
  list)
    pdbedit -L
    ;;
  *)
    echo "usage: lanlord-user add NAME | admin | delete NAME | list" >&2
    exit 2
    ;;
esac
