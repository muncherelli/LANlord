{% set nets = lanlord_networks | default([]) %}
{% set out = host_interface | default('') %}
{% set whole = nets | selectattr('internet') | list %}
{% set some = nets | rejectattr('internet') | selectattr('internet_allow') | list %}
{% set reaching = whole + some %}
# written by lanlord; changes here are overwritten
# netbios, smb, dns and dhcp are kept off the host network ({{ host_interface }}). the lanlord networks
# ({{ lan_interfaces | join(', ') if lan_interfaces | length > 0 else 'none' }}) are accepted first, so
# these rules can never cut off one of them.
{% if lan_interfaces | length > 0 %}
# the lanlord networks never forward to each other or in from outside. they have no internet unless
# a network says so, or a computer is allowed (by mac, for good or until a time) on a network that
# does not: only then do their clients go out through {{ out }}, translated to its address.
{% endif %}
add table inet lanlord
delete table inet lanlord
table inet lanlord {
{% for net in some %}
  # {{ net.name }}: the computers allowed out, each removed by nft itself when its time is up. the
  # set is empty here, so a boot never reopens a grant that ended while the machine was off: the
  # elements are added from internet-elements.nft, worked out again from the end times.
  set internet_{{ net.name | replace('-', '_') }} {
    type ether_addr
    flags timeout
  }
{% endfor %}
  chain input {
    type filter hook input priority -10; policy accept;
{% if lan_interfaces | length > 0 %}
    iifname { {% for name in lan_interfaces %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} } accept
{% endif %}
{% if host_interface | default('') != '' %}
    iifname "{{ host_interface }}" udp dport { 137, 138 } drop
    iifname "{{ host_interface }}" tcp dport { 139, 445 } drop
    iifname "{{ host_interface }}" udp dport { 53, 67, 123 } drop
    iifname "{{ host_interface }}" tcp dport 53 drop
{% endif %}
  }
  chain output {
    type filter hook output priority -10; policy accept;
{% if host_interface | default('') != '' %}
    oifname "{{ host_interface }}" udp sport 67 drop
{% endif %}
  }
{% if lan_interfaces | length > 0 %}
  chain forward {
    type filter hook forward priority -10; policy accept;
{% if reaching | length > 0 and out != '' %}
    iifname "{{ out }}" oifname { {% for net in reaching %}"{{ net.interface }}"{% if not loop.last %}, {% endif %}{% endfor %} } ct state established,related accept
{% for net in whole %}
    iifname "{{ net.interface }}" oifname "{{ out }}" accept
{% endfor %}
{% for net in some %}
    iifname "{{ net.interface }}" oifname "{{ out }}" ether saddr @internet_{{ net.name | replace('-', '_') }} accept
{% endfor %}
{% endif %}
    iifname { {% for name in lan_interfaces %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} } drop
    oifname { {% for name in lan_interfaces %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} } drop
  }
{% endif %}
{% if reaching | length > 0 and out != '' %}
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
{% for net in reaching %}
    oifname "{{ out }}" ip saddr {{ net.subnet }} masquerade
{% endfor %}
  }
{% endif %}
}
