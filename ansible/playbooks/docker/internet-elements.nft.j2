{% set nets = lanlord_networks | default([]) %}
{% for net in nets | rejectattr('internet') | selectattr('internet_allow') %}
flush set inet lanlord internet_{{ net.name | replace('-', '_') }}
add element inet lanlord internet_{{ net.name | replace('-', '_') }} { {% for host in net.internet_allow %}{{ host.mac }}{% if host.seconds is not none %} timeout {{ host.seconds }}s{% endif %}{% if not loop.last %}, {% endif %}{% endfor %} }
{% endfor %}
