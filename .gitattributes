# the playbooks and the samba image files are embedded in the binary and run on
# linux, so they must keep unix line endings even when checked out on windows
ansible/** text eol=lf

# the tui layout snapshots are compared byte for byte
crates/tui/src/shell/snapshots/*.txt text eol=lf

# read by tools/set-version.sh, which edits them with unix tools
*.sh text eol=lf
Cargo.toml text eol=lf

# compared byte for byte with what the engine and the playbook render
crates/core/tests/fixtures/** text eol=lf
